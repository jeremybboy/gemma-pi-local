#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")/.." && pwd)"
RUNTIME_DIR="${ROOT_DIR}/.runtime"
PID_FILE="${RUNTIME_DIR}/gemma-pi.pid"
LOG_FILE="${RUNTIME_DIR}/gemma-pi.log"

if [[ -f "${ROOT_DIR}/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "${ROOT_DIR}/.env"
  set +a
fi

APP_PORT="${GEMMA_PI_PORT:-8080}"
SEARCH_ENABLED="${GEMMA_PI_SEARCH_ENABLED:-true}"

is_running() {
  [[ -f "${PID_FILE}" ]] || return 1
  local pid
  pid="$(cat "${PID_FILE}")"
  [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null
}

search_enabled() {
  case "${SEARCH_ENABLED,,}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_search() {
  search_enabled || return 0
  if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
    echo "Warning: Docker Compose is unavailable; web-search requests will be unavailable." >&2
    return 0
  fi
  if ! "${ROOT_DIR}/scripts/searxng.sh" start; then
    echo "Warning: SearXNG did not start; web-search requests will be unavailable." >&2
  fi
}

show_help() {
  cat <<'EOF'
Gemma Pi Local

Usage: gemma-pi <command>

Commands:
  start           Start LiteRT-LM and the web app in the background
  stop            Stop both processes cleanly
  status          Show process and API status
  logs [--follow] Show recent logs
  ui              Print the trusted-LAN browser URL
  doctor          Check the Pi, runtime, model, storage, and thermals
EOF
}

start_app() {
  ensure_search
  if is_running; then
    echo "Gemma Pi Local is already running (PID $(cat "${PID_FILE}"))."
    return
  fi
  mkdir -p "${RUNTIME_DIR}"
  : >"${LOG_FILE}"
  nohup "${ROOT_DIR}/start.sh" >>"${LOG_FILE}" 2>&1 &
  echo $! >"${PID_FILE}"
  echo "Starting Gemma Pi Local..."
  for _ in $(seq 1 130); do
    if ! is_running; then
      echo "Startup failed. Recent log:" >&2
      tail -n 40 "${LOG_FILE}" >&2
      rm -f "${PID_FILE}"
      return 1
    fi
    if "${ROOT_DIR}/.venv/bin/python" - "${APP_PORT}" <<'PY'
import socket
import sys
try:
    with socket.create_connection(("127.0.0.1", int(sys.argv[1])), timeout=0.3):
        pass
except OSError:
    raise SystemExit(1)
PY
    then
      echo "Ready: $("${SCRIPT_PATH}" ui | tail -n 1)"
      return
    fi
    sleep 1
  done
  echo "Startup timed out. Run: gemma-pi logs" >&2
  return 1
}

stop_app() {
  if ! is_running; then
    echo "Gemma Pi Local is not running."
    rm -f "${PID_FILE}"
    return
  fi
  local pid
  pid="$(cat "${PID_FILE}")"
  kill "${pid}"
  for _ in $(seq 1 20); do
    if ! kill -0 "${pid}" 2>/dev/null; then
      rm -f "${PID_FILE}"
      echo "Gemma Pi Local stopped."
      return
    fi
    sleep 0.5
  done
  echo "Process ${pid} did not stop cleanly." >&2
  return 1
}

show_status() {
  if ! is_running; then
    echo "Gemma Pi Local: stopped"
    return 1
  fi
  echo "Gemma Pi Local: running (PID $(cat "${PID_FILE}"))"
  "${ROOT_DIR}/.venv/bin/python" - "${APP_PORT}" <<'PY'
import json
import sys
import urllib.request

try:
    with urllib.request.urlopen(f"http://127.0.0.1:{sys.argv[1]}/api/status", timeout=3) as response:
        data = json.load(response)
except Exception as exc:
    print(f"API: unavailable ({exc})")
    raise SystemExit(1)

system = data.get("system", {})
litert = data.get("litert", {})
print(f"LiteRT-LM: {'ready' if litert.get('ok') else 'offline'}")
search = data.get("search", {})
print(f"Web search: {'ready' if search.get('ok') else 'offline'}")
print(f"Temperature: {system.get('temperature_c', 'unavailable')} C")
print(f"Throttled: {system.get('throttled', {}).get('raw', 'unavailable')}")
PY
}

show_ui() {
  local ip
  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  [[ -n "${ip}" ]] || ip="127.0.0.1"
  echo "http://${ip}:${APP_PORT}"
}

command="${1:-help}"
case "${command}" in
  start) start_app ;;
  stop) stop_app ;;
  status) show_status ;;
  logs)
    if [[ "${2:-}" == "--follow" ]]; then
      tail -n 100 -f "${LOG_FILE}"
    else
      tail -n 100 "${LOG_FILE}"
    fi
    ;;
  ui) show_ui ;;
  doctor) "${ROOT_DIR}/scripts/doctor.sh" ;;
  help|-h|--help) show_help ;;
  *)
    echo "Unknown command: ${command}" >&2
    show_help >&2
    exit 2
    ;;
esac
