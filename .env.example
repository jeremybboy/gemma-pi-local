# Web UI (reachable from the trusted LAN)
GEMMA_PI_HOST=0.0.0.0
GEMMA_PI_PORT=8080

# LiteRT-LM server (loopback only)
GEMMA_PI_LITERT_HOST=127.0.0.1
GEMMA_PI_LITERT_PORT=9379
GEMMA_PI_LITERT_URL=http://127.0.0.1:9379/v1

# Imported LiteRT-LM model ID
GEMMA_PI_MODEL=gemma4-e4b

# Upload and conversation limits
GEMMA_PI_MAX_REQUEST_BYTES=33554432
GEMMA_PI_MAX_ATTACHMENT_BYTES=8388608
GEMMA_PI_MAX_MESSAGES=24

# Agentic web search (SearXNG remains loopback-only)
GEMMA_PI_SEARCH_ENABLED=true
GEMMA_PI_SEARXNG_URL=http://127.0.0.1:8888
GEMMA_PI_SEARCH_TIMEOUT_SECONDS=12
GEMMA_PI_SEARCH_MAX_RESULTS=5
